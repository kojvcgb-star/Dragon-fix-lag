RunService.RenderStepped:Connect(function()
    Frames += 1

    local Now = os.clock()

    if Now - Last >= 1 then
        FPS = math.floor(Frames / (Now - Last))
        Counter.Text = "FPS: " .. FPS

        Frames = 0
        Last = Now
    end
end)

