-- SETTINGS
local Enabled = false
local SelectedLevel = 1
local Original = {}
local OriginalQuality

-- Save and change properties
local function SetProperty(obj, prop, value)
    if not obj then return end

    if not Original[obj] then
        Original[obj] = {}
    end

    if Original[obj][prop] == nil then
        local ok, old = pcall(function()
            return obj[prop]
        end)

        if not ok then return end
        Original[obj][prop] = old
    end

    pcall(function()
        obj[prop] = value
    end)
end

-- Restore graphics
local function Restore()
    for obj, properties in pairs(Original) do
        for prop, old in pairs(properties) do
            pcall(function()
                obj[prop] = old
            end)
        end
    end

    Original = {}

    if OriginalQuality ~= nil then
        pcall(function()
            settings().Rendering.QualityLevel = OriginalQuality
        end)
        OriginalQuality = nil
    end
end

-- Apply selected level
local function Optimize(level)
    Restore()

    SelectedLevel = level

    pcall(function()
        if OriginalQuality == nil then
            OriginalQuality = settings().Rendering.QualityLevel
        end

        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    SetProperty(Lighting, "GlobalShadows", false)
    SetProperty(Lighting, "FogEnd", 1000000)

    for _, obj in ipairs(Workspace:GetDescendants()) do

        if level >= 2 then
            if obj:IsA("ParticleEmitter") then
                SetProperty(obj, "Enabled", false)
            end
        end

        if level >= 3 then
            if obj:IsA("Trail") or obj:IsA("Beam") then
                SetProperty(obj, "Enabled", false)
            end
        end

        if level >= 4 then
            if obj:IsA("PostEffect") then
                SetProperty(obj, "Enabled", false)
            end
        end

        if level >= 5 then
            if obj:IsA("BasePart") then
                SetProperty(obj, "CastShadow", false)
            end
        end

        if level >= 6 then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                SetProperty(obj, "Transparency", 1)
            end
        end
    end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")

    if terrain and level >= 6 then
        SetProperty(terrain, "Decoration", false)
    end
end

