local FeatureButtons = {}

local function UpdateFeatureButton(name)
    local b = FeatureButtons[name]
    if not b then return end

    local state = Features[name]

    b.Text = FeatureLabels[name] ..
        (state and " : ON" or " : OFF")

    b.BackgroundColor3 = state and GREEN or RED
end

for _, name in ipairs(FeatureNames) do
    local b = Button(
        FeatureLabels[name],
        Features[name] and GREEN or RED,
        function()
            Features[name] = not Features[name]

            if Enabled then
                ApplyAll()
            end

            UpdateFeatureButton(name)
            UpdateStatus()
        end
    )

    FeatureButtons[name] = b
    UpdateFeatureButton(name)
end

