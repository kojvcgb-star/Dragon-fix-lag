local LevelButtons = {}

local function UpdateStatus()
    Status.Text = Enabled and
        ("STATUS: ON | LEVEL " .. Level) or
        "STATUS: OFF"
end

-- Six levels: selecting one applies immediately
for i = 1, 6 do
    local b = MakeButton("LEVEL " .. i, BLUE, function()
        ApplyLevel(i)

        for n, btn in ipairs(LevelButtons) do
            btn.BackgroundColor3 =
                n == i and GREEN or BLUE
        end

        UpdateStatus()
    end)

    LevelButtons[i] = b
end

