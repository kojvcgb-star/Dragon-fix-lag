        Power.Text = "FPS BOOST: OFF"
        Power.BackgroundColor3 = RED
    else
        ApplyLevel(Level)
        Power.Text = "FPS BOOST: ON"
        Power.BackgroundColor3 = GREEN
    end

    UpdateStatus()
end)

