local connRender = RunService.RenderStepped:Connect(function()
    frameCounter += 1
    local now = os.clock()
    local elapsed = now - lastTick
    if elapsed >= 1 then
        local fps = math.floor(frameCounter / elapsed + 0.5)
        Counter.Text = "FPS: " .. fps
