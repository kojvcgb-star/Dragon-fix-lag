-- STATE
local Enabled = false
local Level = 1
local Saved = {}
local SavedQuality = nil
local Connections = {}

local function SaveSet(obj, prop, value)
    if not Saved[obj] then
        Saved[obj] = {}
    end

    if Saved[obj][prop] == nil then
        local success, old = pcall(function()
            return obj[prop]
        end)

        if not success then return end
        Saved[obj][prop] = old
    end

    pcall(function()
        obj[prop] = value
    end)
end

local function RestoreProperties()
    for obj, props in pairs(Saved) do
        for prop, value in pairs(props) do
            pcall(function()
                obj[prop] = value
            end)
        end
    end

    Saved = {}
end

local function RestoreAll()
    Enabled = false

    RestoreProperties()

    if SavedQuality ~= nil then
        pcall(function()
            settings().Rendering.QualityLevel = SavedQuality
        end)
        SavedQuality = nil
    end
end

-- OPTIMIZATION ENGINE
local function OptimizeObject(obj)
    if not Enabled then return end

    if Level >= 2 then
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Fire")
        or obj:IsA("Smoke")
        or obj:IsA("Sparkles") then
            SaveSet(obj, "Enabled", false)
        end
    end

    if Level >= 3 then
        if obj:IsA("Trail") or obj:IsA("Beam") then
            SaveSet(obj, "Enabled", false)
        end
    end

    if Level >= 4 then
        if obj:IsA("PostEffect") then
            SaveSet(obj, "Enabled", false)
        end

        if obj:IsA("Atmosphere") then
            SaveSet(obj, "Density", 0)
            SaveSet(obj, "Haze", 0)
            SaveSet(obj, "Glare", 0)
        end
    end

    if Level >= 5 then
        if obj:IsA("BasePart") then
            SaveSet(obj, "CastShadow", false)
        end
    end

    if Level >= 6 then
        if obj:IsA("Decal") or obj:IsA("Texture") then
            SaveSet(obj, "Transparency", 1)
        end

        if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
            SaveSet(obj, "Enabled", false)
        end

        if obj:IsA("Clouds") then
            SaveSet(obj, "Enabled", false)
        end
    end
end

local function ApplyLevel(n)
    Level = n

    -- Reset previous level before applying the new one
    RestoreProperties()

    Enabled = true

    if SavedQuality == nil then
        pcall(function()
            SavedQuality = settings().Rendering.QualityLevel
        end)
    end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    SaveSet(Lighting, "GlobalShadows", false)

    if n >= 1 then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            OptimizeObject(obj)
        end

        for _, obj in ipairs(Lighting:GetDescendants()) do
            OptimizeObject(obj)
        end
    end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")

    if terrain and n >= 6 then
        SaveSet(terrain, "Decoration", false)
    end
end

-- Automatically optimize newly created effects
Connections[#Connections + 1] =
    Workspace.DescendantAdded:Connect(function(obj)
        if Enabled then
            OptimizeObject(obj)
        end
    end)

Connections[#Connections + 1] =
    Lighting.DescendantAdded:Connect(function(obj)
        if Enabled then
