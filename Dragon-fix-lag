local LevelButtons = {}

for i = 1, 6 do
    local B = Button("LEVEL " .. i, BLUE, function()
        SelectedLevel = i

        if Enabled then
            Optimize(i)
            Status.Text = "STATUS: ON | LEVEL " .. i
        else
            Status.Text = "SELECTED LEVEL: " .. i
        end

        for n, btn in pairs(LevelButtons) do
            btn.BackgroundColor3 =
                (n == i and GREEN or BLUE)
        end
    end)

    LevelButtons[i] = B
end

