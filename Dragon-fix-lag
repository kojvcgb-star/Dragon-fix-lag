--==================================================
-- SAFE PROPERTY HELPERS
--==================================================

local function RememberAndSet(obj, prop, value)
    if not obj or not obj.Parent then
        return
    end

    local record = Saved[obj]
    if not record then
        record = {}
        Saved[obj] = record
    end

    if record[prop] == nil then
        local ok, currentVal = pcall(function()
            return obj[prop]
        end)
        if not ok then
            return
        end
        record[prop] = currentVal
    end

    -- Gán trực tiếp cho tốc độ cao; chỉ dùng pcall khi cần
    obj[prop] = value
end

local function RestoreSingleFeature(featureName)
    for obj, record in pairs(Saved) do
        if typeof(obj) == "Instance" and obj.Parent then
            if featureName == "Particles" then
                if record.Enabled ~= nil and (obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")) then
                    obj.Enabled = record.Enabled
                    record.Enabled = nil
                end
            elseif featureName == "Trails" then
                if record.Enabled ~= nil and (obj:IsA("Trail") or obj:IsA("Beam")) then
                    obj.Enabled = record.Enabled
                    record.Enabled = nil
                end
            elseif featureName == "PostFX" then
                if record.Enabled ~= nil and obj:IsA("PostEffect") then
                    obj.Enabled = record.Enabled
                    record.Enabled = nil
                end
                if obj:IsA("Atmosphere") then
                    if record.Density ~= nil then obj.Density = record.Density; record.Density = nil end
                    if record.Haze ~= nil then obj.Haze = record.Haze; record.Haze = nil end
                    if record.Glare ~= nil then obj.Glare = record.Glare; record.Glare = nil end
                end
            elseif featureName == "Lighting" then
                if record.Enabled ~= nil and (obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight")) then
                    obj.Enabled = record.Enabled
                    record.Enabled = nil
                end
                if obj == Lighting then
                    if record.EnvironmentDiffuseScale ~= nil then Lighting.EnvironmentDiffuseScale = record.EnvironmentDiffuseScale; record.EnvironmentDiffuseScale = nil end
                    if record.EnvironmentSpecularScale ~= nil then Lighting.EnvironmentSpecularScale = record.EnvironmentSpecularScale; record.EnvironmentSpecularScale = nil end
                end
            elseif featureName == "Materials" and obj:IsA("BasePart") then
                if record.Material ~= nil then obj.Material = record.Material; record.Material = nil end
                if record.Reflectance ~= nil then obj.Reflectance = record.Reflectance; record.Reflectance = nil end
            elseif featureName == "Textures" and (obj:IsA("Decal") or obj:IsA("Texture")) then
                if record.Transparency ~= nil then obj.Transparency = record.Transparency; record.Transparency = nil end
            elseif featureName == "HideMap" then
                if obj:IsA("BasePart") and record.LocalTransparencyModifier ~= nil then
                    obj.LocalTransparencyModifier = record.LocalTransparencyModifier
                    record.LocalTransparencyModifier = nil
                end
                if obj:IsA("Terrain") and record.Decoration ~= nil then
                    obj.Decoration = record.Decoration
                    record.Decoration = nil
                end
            elseif featureName == "Shadows" then
                if obj:IsA("BasePart") and record.CastShadow ~= nil then
                    obj.CastShadow = record.CastShadow
                    record.CastShadow = nil
                end
                if obj == Lighting and record.GlobalShadows ~= nil then
                    Lighting.GlobalShadows = record.GlobalShadows
                    record.GlobalShadows = nil
                end
            end
        end
    end
end

local function RestoreAll()
    RunToken += 1
    Enabled = false
    ActiveLevel = 0

    for obj, record in pairs(Saved) do
        if typeof(obj) == "Instance" and obj.Parent then
            for prop, oldVal in pairs(record) do
                pcall(function()
                    obj[prop] = oldVal
                end)
            end
        end
    end

    table.clear(Saved)

    if OriginalQuality ~= nil then
        pcall(function()
            settings().Rendering.QualityLevel = OriginalQuality
        end)
        OriginalQuality = nil
    end
end

--==================================================
-- CHARACTER & TOOL PROTECTION
--==================================================

local function IsProtected(obj)
    local current = obj.Parent
    while current and current ~= Workspace do
        if current:IsA("Tool") then
            return true
        end
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        current = current.Parent
    end
    return false
end

--==================================================
-- CORE OPTIMIZER ENGINE
--==================================================

local function OptimizeInstance(obj, targetFeature)
    if not Enabled or not obj or not obj.Parent then
        return
    end
    if IsProtected(obj) then
        return
    end

    local checkAll = (targetFeature == nil)

    if (checkAll or targetFeature == "Particles") and Features.Particles then
        if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            RememberAndSet(obj, "Enabled", false)
        end
    end

    if (checkAll or targetFeature == "Trails") and Features.Trails then
        if obj:IsA("Trail") or obj:IsA("Beam") then
            RememberAndSet(obj, "Enabled", false)
        end
    end

    if (checkAll or targetFeature == "PostFX") and Features.PostFX then
        if obj:IsA("PostEffect") then
            RememberAndSet(obj, "Enabled", false)
        elseif obj:IsA("Atmosphere") then
            RememberAndSet(obj, "Density", 0)
            RememberAndSet(obj, "Haze", 0)
            RememberAndSet(obj, "Glare", 0)
        end
    end

    if (checkAll or targetFeature == "Lighting") and Features.Lighting then
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            RememberAndSet(obj, "Enabled", false)
        end
    end

    if obj:IsA("BasePart") then
        if (checkAll or targetFeature == "Materials") and Features.Materials then
            RememberAndSet(obj, "Material", Enum.Material.SmoothPlastic)
            RememberAndSet(obj, "Reflectance", 0)
        end

        if (checkAll or targetFeature == "HideMap") and Features.HideMap then
            RememberAndSet(obj, "LocalTransparencyModifier", 1)
        end

        if (checkAll or targetFeature == "Shadows") and Features.Shadows then
            RememberAndSet(obj, "CastShadow", false)
        end
    elseif (checkAll or targetFeature == "Textures") and Features.Textures then
        if obj:IsA("Decal") or obj:IsA("Texture") then
            RememberAndSet(obj, "Transparency", 1)
        end
    elseif (checkAll or targetFeature == "HideMap") and Features.HideMap and obj:IsA("Terrain") then
        RememberAndSet(obj, "Decoration", false)
    end
end

local function ApplyGlobalSettings()
    if Features.Shadows then
        RememberAndSet(Lighting, "GlobalShadows", false)
    end

    if Features.Lighting then
        RememberAndSet(Lighting, "EnvironmentDiffuseScale", 0)
        RememberAndSet(Lighting, "EnvironmentSpecularScale", 0)
    end

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain and Features.HideMap then
        RememberAndSet(terrain, "Decoration", false)
    end

    if OriginalQuality == nil then
        pcall(function()
            OriginalQuality = settings().Rendering.QualityLevel
        end)
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
end

local function ScanDescendantsAsync(targetFeature, token)
    local descendants = Workspace:GetDescendants()
    local batchSize = 1800

    for i = 1, #descendants do
        if not Enabled or token ~= RunToken then
            return
        end

        OptimizeInstance(descendants[i], targetFeature)

        if i % batchSize == 0 then
            task.wait()
        end
    end

    for _, obj in ipairs(Lighting:GetDescendants()) do
        if not Enabled or token ~= RunToken then
            return
        end
        OptimizeInstance(obj, targetFeature)
    end
end

local function ApplyBoost(targetFeature)
    if IsApplying then return end
    IsApplying = true

    RunToken += 1
    local token = RunToken
    Enabled = true

    ApplyGlobalSettings()
    task.spawn(function()
        ScanDescendantsAsync(targetFeature, token)
        IsApplying = false
    end)
end

local function ToggleFeature(name)
    Features[name] = not Features[name]
    ActiveLevel = 0

    if not Enabled then
        return
    end

    if Features[name] then
        ApplyBoost(name)
    else
        RestoreSingleFeature(name)
    end
end

--==================================================
-- REALTIME NEW OBJECT HANDLER
--==================================================

local function HookContainer(container)
    return container.DescendantAdded:Connect(function(obj)
        if not Enabled then return end
        task.defer(function()
            if Enabled and obj.Parent then
                OptimizeInstance(obj, nil)
            end
        end)
    end)
end

