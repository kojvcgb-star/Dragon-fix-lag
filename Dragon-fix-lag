local MasterButton = nil

local function RefreshUI()
    local activeCount = 0
    for _, name in ipairs(FeatureOrder) do
        local isOn = Features[name]
        if isOn then
            activeCount += 1
        end

        local fBtn = FeatureButtons[name]
        if fBtn then
            fBtn.Text = FeatureLabels[name] .. (isOn and " : ON" or " : OFF")
            fBtn.BackgroundColor3 = isOn and GREEN or RED
        end
    end

    for lvl, pBtn in pairs(PresetButtons) do
        if Enabled and ActiveLevel == lvl then
            pBtn.BackgroundColor3 = GREEN
        elseif lvl == 6 then
            pBtn.BackgroundColor3 = RED
        else
            pBtn.BackgroundColor3 = BLUE
        end
    end

    if MasterButton then
        if Enabled then
            MasterButton.Text = "MASTER BOOST: ON"
            MasterButton.BackgroundColor3 = GREEN
        else
            MasterButton.Text = "MASTER BOOST: OFF"
            MasterButton.BackgroundColor3 = RED
        end
    end

    local presetTag = ActiveLevel > 0 and (" | LV." .. ActiveLevel) or ""
    StatusLabel.Text = (Enabled and "BOOST ON" or "BOOST OFF")
        .. presetTag
        .. " | " .. activeCount .. "/8 FEATURES"
end

local function ApplyPreset(level)
    local presetData = Presets[level]
    if not presetData then return end

    ActiveLevel = level
    for k, v in pairs(presetData) do
        Features[k] = v
    end

    -- Khôi phục các feature bị tắt so với trạng thái cũ rồi quét lại những feature đang bật
    for _, name in ipairs(FeatureOrder) do
        if not Features[name] then
            RestoreSingleFeature(name)
        end
    end

    ApplyBoost(nil)
    RefreshUI()
end

