--==================================================
-- SAVE / RESTORE
--==================================================

local function Set(obj, prop, value)
    if not obj then return end

    if not Saved[obj] then
        Saved[obj] = {}
    end

    if Saved[obj][prop] == nil then
        local ok, old = pcall(function()
            return obj[prop]
        end)

        if not ok then return end
        Saved[obj][prop] = old
    end

    pcall(function()
        obj[prop] = value
    end)
end

local function RestoreProperties()
    for obj, properties in pairs(Saved) do
        for prop, old in pairs(properties) do
            pcall(function()
                obj[prop] = old
            end)
        end
    end

    Saved = {}
end

local function RestoreAll()
    Enabled = false
    RestoreProperties()

    if OriginalQuality ~= nil then
        pcall(function()
            settings().Rendering.QualityLevel = OriginalQuality
        end)

        OriginalQuality = nil
    end
end

--==================================================
-- PROTECTION
--==================================================

local function IsProtected(obj)
    local current = obj

    while current and current ~= Workspace do
        if current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") then
                return true
            end
        end

        if current:IsA("Tool") then
            return true
        end

        current = current.Parent
    end

    return false
end

--==================================================
-- OPTIMIZATION ENGINE
--==================================================

local function OptimizeObject(obj)
    if not Enabled or IsProtected(obj) then
        return
    end

    -- 1. PARTICLES
    if Features.Particles then
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Fire")
        or obj:IsA("Smoke")
        or obj:IsA("Sparkles") then
            Set(obj, "Enabled", false)
        end
    end

    -- 2. TRAILS
    if Features.Trails then
        if obj:IsA("Trail") or obj:IsA("Beam") then
            Set(obj, "Enabled", false)
        end
    end

    -- 3. POST FX
    if Features.PostFX then
        if obj:IsA("PostEffect") then
            Set(obj, "Enabled", false)
        end

        if obj:IsA("Atmosphere") then
            Set(obj, "Density", 0)
            Set(obj, "Haze", 0)
            Set(obj, "Glare", 0)
        end
    end

    -- 4. LIGHTING
    if Features.Lighting then
        if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then
            Set(obj, "Enabled", false)
        end
    end

    -- 5. MATERIALS
    if Features.Materials and obj:IsA("BasePart") then
        Set(obj, "Material", Enum.Material.SmoothPlastic)
        Set(obj, "Reflectance", 0)
    end

    -- 6. TEXTURES
    if Features.Textures then
        if obj:IsA("Decal") or obj:IsA("Texture") then
            Set(obj, "Transparency", 1)
        end
    end

    -- 7. HIDE MAP
    if Features.HideMap and obj:IsA("BasePart") then
        Set(obj, "LocalTransparencyModifier", 1)
    end

    -- 8. SHADOWS
    if Features.Shadows and obj:IsA("BasePart") then
        Set(obj, "CastShadow", false)
    end
end

local function ApplyGlobal()
    if Features.Shadows then
        Set(Lighting, "GlobalShadows", false)
    end

    if Features.Lighting then
        Set(Lighting, "EnvironmentDiffuseScale", 0)
        Set(Lighting, "EnvironmentSpecularScale", 0)
    end

    if OriginalQuality == nil then
        pcall(function()
            OriginalQuality = settings().Rendering.QualityLevel
        end)
    end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    local terrain = Workspace:FindFirstChildOfClass("Terrain")

    if terrain and Features.HideMap then
        Set(terrain, "Decoration", false)
    end
end

local function ApplyAll()
    if Applying then return end
    Applying = true

    RestoreProperties()

    Enabled = true

    ApplyGlobal()

    for _, obj in ipairs(Workspace:GetDescendants()) do
        OptimizeObject(obj)
    end

    for _, obj in ipairs(Lighting:GetDescendants()) do
        OptimizeObject(obj)
    end

    Applying = false
end

