local Frames = 0
local Last = os.clock()

Connections[#Connections + 1] =
    RunService.RenderStepped:Connect(function()
        Frames += 1

        local now = os.clock()

        if now - Last >= 1 then
            Counter.Text = "FPS: " ..
                math.floor(Frames / (now - Last))

            Frames = 0
            Last = now
        end
    end)

